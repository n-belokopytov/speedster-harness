{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speedster/schemas/qa-input.schema.json",
  "title": "QA Agent Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "repo",
    "commit",
    "diff",
    "engineer_output",
    "round"
  ],
  "properties": {
    "task": {
      "$ref": "#/$defs/task"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "root"],
      "properties": {
        "branch": {
          "type": "string",
          "pattern": "^speedster/[A-Za-z0-9._-]+$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "diff": {
      "type": "string"
    },
    "engineer_output": {
      "$ref": "#/$defs/engineerOutput"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "description",
        "acceptance_criteria",
        "context_files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "object",
          "additionalProperties": true,
          "required": ["functional", "solid", "yagni_kiss", "testing"],
          "properties": {
            "functional": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "solid": {
              "type": "string",
              "minLength": 1
            },
            "yagni_kiss": {
              "type": "string",
              "minLength": 1
            },
            "testing": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "context_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "engineerOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "branch",
        "files_changed",
        "tests_added_or_updated",
        "acceptance_evidence",
        "assumptions",
        "notes",
        "blocked_reason",
        "requested_context"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "implemented"
        },
        "branch": {
          "type": "string",
          "pattern": "^speedster/[A-Za-z0-9._-]+$"
        },
        "files_changed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tests_added_or_updated": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["functional", "solid", "yagni_kiss", "testing"],
          "properties": {
            "functional": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["criterion", "evidence"],
                "properties": {
                  "criterion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "solid": {
              "type": "string",
              "minLength": 1
            },
            "yagni_kiss": {
              "type": "string",
              "minLength": 1
            },
            "testing": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 280
        },
        "blocked_reason": {
          "type": "string",
          "const": ""
        },
        "requested_context": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
