{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speedster/schemas/qa-output.schema.json",
  "title": "QA Agent Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "branch",
    "commit",
    "round",
    "findings",
    "rejection_reasons",
    "notes"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["approved", "rejected"]
    },
    "branch": {
      "type": "string",
      "pattern": "^speedster/[A-Za-z0-9._-]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "findings": {
      "$ref": "#/$defs/findings"
    },
    "rejection_reasons": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 280
    }
  },
  "$defs": {
    "verdict": {
      "type": "string",
      "enum": ["met", "unmet", "uncertain"]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "evidence"],
      "properties": {
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "functionalFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "verdict", "evidence"],
      "properties": {
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional", "solid", "yagni_kiss", "testing"],
      "properties": {
        "functional": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/functionalFinding"
          }
        },
        "solid": {
          "$ref": "#/$defs/finding"
        },
        "yagni_kiss": {
          "$ref": "#/$defs/finding"
        },
        "testing": {
          "$ref": "#/$defs/finding"
        }
      }
    }
  }
}
