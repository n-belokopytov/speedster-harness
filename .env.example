# Agent model configuration
MODEL=default

# Agent URLs (used by the orchestrator to connect to agents)
EM_AGENT_URL=http://localhost:8081
ENG_AGENT_URL=http://localhost:8082
QA_AGENT_URL=http://localhost:8083

# Agent port mappings (used by docker-compose to map container ports)
EM_AGENT_PORT=8081
ENG_AGENT_PORT=8082
QA_AGENT_PORT=8083

# Git authentication (required for engineer agent to push code)
# Path to SSH private key file (mounted into containers at /run/secrets/github_ssh_key)
SSH_KEY_PATH=~/.ssh/id_speedster
# Remote repository URL (SSH format, e.g., git@github.com:owner/repo.git)
REPO_URL=git@github.com:owner/repo.git

# PI (pi-coding-agent) setup
# API key for the model endpoint (passed to pi-setup.sh, stored in .pi/agent/models.json)
# API_KEY=your-api-key
# Override PI config directory (default: $HOME/.pi/agent)
# PI_CONFIG_DIR=/custom/path/.pi/agent
