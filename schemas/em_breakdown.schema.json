{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speedster/schemas/em-breakdown.schema.json",
  "title": "EM Breakdown Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "subtasks"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/subtask"
      }
    }
  },
  "$defs": {
    "subtaskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+-[0-9]+$"
    },
    "acceptanceCriterion": {
      "type": "string",
      "minLength": 8
    },
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "acceptance_criteria",
        "context_files",
        "depends_on",
        "parallel_group",
        "estimated_context_tokens",
        "estimated_work_tokens",
        "complexity_level",
        "target_model_class",
        "status",
        "qa_rounds",
        "feedback"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/subtaskId"
        },
        "description": {
          "type": "string",
          "minLength": 12
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 5,
          "allOf": [
            {
              "contains": {
                "type": "string",
                "pattern": "(?i)solid"
              }
            },
            {
              "contains": {
                "type": "string",
                "pattern": "(?i)yagni"
              }
            },
            {
              "contains": {
                "type": "string",
                "pattern": "(?i)kiss"
              }
            },
            {
              "contains": {
                "type": "string",
                "pattern": "(?i)(unit test|unit tests)"
              }
            },
            {
              "contains": {
                "type": "string",
                "pattern": "(?i)(80\\s*%\\+?|>=\\s*80\\s*%)"
              }
            }
          ],
          "items": {
            "$ref": "#/$defs/acceptanceCriterion"
          }
        },
        "context_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subtaskId"
          }
        },
        "parallel_group": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_context_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 19999
        },
        "estimated_work_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80000
        },
        "complexity_level": {
          "type": "string",
          "enum": [
            "simple",
            "straightforward"
          ]
        },
        "target_model_class": {
          "type": "string",
          "const": "mid-size-25B"
        },
        "status": {
          "type": "string",
          "const": "pending"
        },
        "qa_rounds": {
          "type": "integer",
          "const": 0
        },
        "feedback": {
          "type": "null"
        }
      }
    }
  }
}
